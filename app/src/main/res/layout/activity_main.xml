<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Both WebViews stay attached so Gemini keeps running behind the custom chat. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/geminiView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <WebView
            android:id="@+id/chatView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bar"
        android:elevation="8dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/tabGemini"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_gemini"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/pillGemini"
                android:layout_width="68dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill">

                <ImageView
                    android:id="@+id/iconGemini"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_gemini" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tabChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="@string/tab_chat"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/pillChat"
                android:layout_width="68dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill">

                <ImageView
                    android:id="@+id/iconChat"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_custom" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
