<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_bg"
    android:padding="20dp"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Default Home Page" android:textColor="@color/text_secondary"/>
        <EditText android:id="@+id/settingsHomePage"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/url_bg" android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:importantForAutofill="no"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Website Text Size (50–200%)" android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp"/>
        <SeekBar android:id="@+id/settingsTextSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="200" android:progress="100"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="URL Bar Position" android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp"/>
        <RadioGroup android:id="@+id/urlPositionGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/urlPosBottom"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bottom" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/urlPosTop"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Top" android:textColor="@color/text_primary"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tabs Position" android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp"/>
        <RadioGroup android:id="@+id/tabsPositionGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/tabsOff"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Off" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/tabsBottom"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bottom (Horizontal)" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/tabsLeft"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Left (Vertical)" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/tabsRight"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Right (Vertical)" android:textColor="@color/text_primary"/>
        </RadioGroup>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bottom Tabs — Visible Count" android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp"/>
        <SeekBar android:id="@+id/settingsBottomTabCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="10" android:progress="4"/>

        <CheckBox android:id="@+id/settingsAlwaysShowSide"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Always show side tabs (icons only)"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hide URL Toolbar" android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp"/>
        <RadioGroup android:id="@+id/hideToolbarGroup"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/hideOff"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Off" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/hideOnScroll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="On Scroll" android:textColor="@color/text_primary"/>
            <RadioButton android:id="@+id/hideOnLock"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="On &amp; Lock (arrow button to restore)"
                android:textColor="@color/text_primary"/>
        </RadioGroup>

        <Button android:id="@+id/settingsApply"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Apply Settings"
            android:backgroundTint="@color/accent"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
